Options -Indexes
DirectoryIndex index.php
DirectorySlash Off
RewriteEngine On
RewriteRule ^(?:app|includes|config|database|bin|docs|tests|reference|data|storage/private|storage/logs)(?:/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(fr|ar)/(.*)\.html$ page.php [END,QSA]
RewriteRule ^api/auth/register$ api/auth/register.php [END,QSA]
RewriteRule ^api/auth/register-professional$ api/auth/register_professional.php [END,QSA]
RewriteRule ^api/auth/login$ api/auth/login.php [END,QSA]
RewriteRule ^api/auth/logout$ api/auth/logout.php [END,QSA]
RewriteRule ^api/auth/me$ api/auth/me.php [END,QSA]
RewriteRule ^api/auth/forgot-password$ api/auth/forgot_password.php [END,QSA]
RewriteRule ^api/auth/reset-password$ api/auth/reset_password.php [END,QSA]
RewriteRule ^api/companions/([0-9]+)/owners/([0-9]+)/confirm$ api/companions/owners_confirm.php?id=$1&invite_id=$2 [END,QSA]
RewriteRule ^api/companions/([0-9]+)/owners$ api/companions/owners.php?id=$1 [END,QSA]
RewriteRule ^api/companions/([0-9]+)/vet$ api/companions/vet.php?id=$1 [END,QSA]
RewriteRule ^api/companions/([0-9]+)/status$ api/companions/status.php?id=$1 [END,QSA]
RewriteRule ^api/companions/([0-9]+)$ api/companions/detail.php?id=$1 [END,QSA]
RewriteRule ^api/companions$ api/companions/index.php [END,QSA]
RewriteRule ^api/professionals/me$ api/professionals/me.php [END,QSA]
RewriteRule ^api/professionals/clients/([0-9]+)/companions$ api/professionals/register_companion.php?client_id=$1 [END,QSA]
RewriteRule ^api/professionals/clients/([0-9]+)$ api/professionals/client_detail.php?id=$1 [END,QSA]
RewriteRule ^api/professionals/clients$ api/professionals/clients.php [END,QSA]
RewriteRule ^api/professionals/recent-companions$ api/professionals/recent_companions.php [END,QSA]
RewriteRule ^api/professionals/search-serial/(.+)$ api/professionals/search_serial.php?serial=$1 [END,QSA]
RewriteRule ^api/professionals/companions/([0-9]+)/session-notes$ api/professionals/session_notes.php?companion_id=$1 [END,QSA]
RewriteRule ^api/professionals/([0-9]+)/verification$ api/professionals/verification.php?id=$1 [END,QSA]
RewriteRule ^api/professionals$ api/professionals/verification.php [END,QSA]
RewriteRule ^api/crm/leads$ api/crm/leads.php [END,QSA]
RewriteRule ^api/crm/segments$ api/crm/segments.php [END,QSA]
RewriteRule ^api/crm/interactions$ api/crm/interactions.php [END,QSA]
RewriteRule ^api/crm/followups/([0-9]+)/status$ api/crm/followup_status.php?id=$1 [END,QSA]
RewriteRule ^api/crm/followups$ api/crm/followups.php [END,QSA]
RewriteRule ^api/crm/customers/([0-9]+)/status$ api/crm/customer_status.php?id=$1 [END,QSA]
RewriteRule ^api/crm/customers/([0-9]+)/notes$ api/crm/notes.php?id=$1 [END,QSA]
RewriteRule ^api/crm/customers/([0-9]+)/interactions$ api/crm/customer_interactions.php?id=$1 [END,QSA]
RewriteRule ^api/crm/customers/([0-9]+)/followups$ api/crm/customer_followups.php?id=$1 [END,QSA]
RewriteRule ^api/crm/customers/([0-9]+)$ api/crm/customer_detail.php?id=$1 [END,QSA]
RewriteRule ^api/crm/customers$ api/crm/customers.php [END,QSA]
RewriteRule ^api/orders/preview$ api/orders/preview.php [END,QSA]
RewriteRule ^api/orders/([0-9]+)/status$ api/orders/status.php?id=$1 [END,QSA]
RewriteRule ^api/orders/([0-9]+)$ api/orders/detail.php?id=$1 [END,QSA]
RewriteRule ^api/orders$ api/orders/index.php [END,QSA]
RewriteRule ^api/products$ api/products.php [END,QSA]
RewriteRule ^api/movement$ api/movement.php [END,QSA]
RewriteRule ^api/nero/ask$ api/nero.php [END,QSA]
RewriteRule ^api/admin/overview$ api/admin/overview.php [END,QSA]
RewriteRule ^api/admin/users/([0-9]+)/status$ api/admin/user_status.php?id=$1 [END,QSA]
RewriteRule ^api/admin/users$ api/admin/users.php [END,QSA]
RewriteRule ^api/admin/companions$ api/admin/companions.php [END,QSA]
RewriteRule ^api/admin/products/([0-9]+)$ api/admin/products.php?id=$1 [END,QSA]
RewriteRule ^api/admin/products$ api/admin/products.php [END,QSA]
RewriteRule ^api/admin/promo/([0-9]+)/active$ api/admin/promo_active.php?id=$1 [END,QSA]
RewriteRule ^api/admin/promo$ api/admin/promo.php [END,QSA]
RewriteRule ^api/admin/settings$ api/admin/settings.php [END,QSA]
RewriteRule ^api(?:/|$) api/index.php [END,QSA]
RewriteRule ^id/([A-Za-z0-9-]+)$ id/index.php?value=$1 [END,QSA]
RewriteRule ^q/([A-Za-z0-9-]+)$ q/index.php?token=$1 [END,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [END]
RewriteRule ^robots\.txt$ robots.php [END]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ page.php [END,QSA]
